generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?
  notes     String?
  createdAt DateTime   @default(now())
  purchases Purchase[]
}

model Buyer {
  id              Int        @id @default(autoincrement())
  name            String
  imageUrl        String?
  createdAt       DateTime   @default(now())
  purchases       Purchase[] @relation("BuyerPurchases")
  paidPurchases   Purchase[] @relation("PaidByPurchases")
}

model Purchase {
  id            Int             @id @default(autoincrement())
  shopId        Int
  buyerId       Int
  purchaseDate  DateTime
  totalAmount   Decimal         @db.Decimal(10, 2)
  paidAmount    Decimal         @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus   @default(UNPAID)
  paidById      Int?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  description   String?

  shop    Shop            @relation(fields: [shopId], references: [id])
  buyer   Buyer           @relation("BuyerPurchases", fields: [buyerId], references: [id])
  paidBy  Buyer?          @relation("PaidByPurchases", fields: [paidById], references: [id])
  images  PurchaseImage[]
  items   PurchaseItem[]
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  name       String
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model PurchaseImage {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  imageUrl   String
  isReceipt  Boolean  @default(false)
  createdAt  DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model User {
  id            Int               @id @default(autoincrement())
  name          String            @unique
  normalizedName String           @unique
  passwordHash  String
  familyGroup   String            @default("default")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  receivedNotifs    Notification[] @relation("NotificationRecipient")
  sentNotifs        Notification[] @relation("NotificationActor")
  pushSubscriptions PushSubscription[]

  @@index([familyGroup])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  replacedByTokenHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  userName   String
  action     String
  entityType String
  entityId   Int?
  entityName String?
  amount     Decimal? @db.Decimal(10, 2)
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model Notification {
  id          Int      @id @default(autoincrement())
  actorId     Int?
  actorName   String
  recipientId Int
  type        String
  title       String
  message     String
  entityType  String?
  entityId    Int?
  entityName  String?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  keysAuth  String
  keysP256dh String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
